---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';
import { villa, type Locale } from '../data/villa';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section amenities" id="villa">
  <div class="container">
    <div class="amenities__head reveal">
      <p class="eyebrow">{t('amenities.eyebrow')}</p>
      <h2 class="section-title">{t('amenities.title')}</h2>
      <p class="lead">{t('amenities.subtitle')}</p>
    </div>

    <div class="amenities__groups">
      {villa.amenityGroups.map((group) => (
        <div class="amenities__group reveal">
          <h3 class="amenities__group-title">{t(`amenities.groups.${group.id}`)}</h3>
          <ul class="amenities__list">
            {group.items.map((item) => (
              <li class="amenities__item">
                <span class="amenities__icon"><Icon name={item.icon} size={22} /></span>
                <span>{t(`amenities.items.${item.id}`)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="amenities__all reveal">
      <h3 class="amenities__all-title">{t('amenities.allTitle')}</h3>
      <div class="amenities__all-groups">
        {villa.facilityGroups.map((group) => (
          <div class="amenities__all-group">
            <h4 class="amenities__all-group-title">{t(`amenities.facilityGroups.${group.id}`)}</h4>
            <ul>
              {group.items.map((id) => <li>{t(`amenities.facilities.${id}`)}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .amenities {
    background: var(--bg-raised);
  }
  .amenities__head {
    max-width: var(--container-narrow);
    margin-bottom: 3rem;
  }
  .amenities__groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .amenities__group-title {
    font-size: var(--fs-h3);
    padding-bottom: 0.9rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .amenities__list { display: grid; gap: 1rem; }
  .amenities__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-weight: 500;
    color: var(--heading);
  }
  .amenities__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    background: var(--c-white);
    color: var(--c-sea);
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .amenities__groups { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  @media (max-width: 560px) {
    .amenities__groups { grid-template-columns: 1fr; }
  }
  .amenities__all {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .amenities__all-title {
    font-size: var(--fs-h3);
    margin-bottom: 1.75rem;
  }
  /*
   * CSS columns, not a grid: the groups differ wildly in length (18 outdoor
   * items against 4 for the children), and a grid would align them in rows and
   * leave a large hole under the short ones.
   */
  .amenities__all-groups {
    column-count: 3;
    column-gap: 2.5rem;
  }
  .amenities__all-group {
    break-inside: avoid;
    margin-bottom: 2rem;
  }
  .amenities__all-group-title {
    font-size: 0.78rem;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 0.7rem;
  }
  .amenities__all-group ul { display: grid; gap: 0.3rem; }
  .amenities__all-group li {
    font-size: var(--fs-small);
    line-height: 1.5;
    position: relative;
    padding-left: 0.95rem;
  }
  .amenities__all-group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--c-olive);
  }
  @media (max-width: 860px) {
    .amenities__all-groups { column-count: 2; }
  }
  @media (max-width: 560px) {
    .amenities__all-groups { column-count: 1; }
  }
</style>
