---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';
import { villa, type Locale } from '../data/villa';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Load every placeholder in the gallery folder.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/gallery/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

// Map filename token -> caption key. captionKey() does a SUBSTRING match in
// key order, so every compound token must be listed before the shorter token
// it contains: `pool-loungers` before `pool-lounge`, `living-doors` before
// `living`, `dusk-olive` before `dusk`, and so on.
const captionByToken: Record<string, string> = {
  'pool-villa': 'poolVilla',
  'pool-garden': 'poolGarden',
  'pool-montgo': 'poolMontgo',
  'pool-pergola': 'poolPergola',
  'pool-loungers': 'poolLoungers',
  'pool-planting': 'poolPlanting',
  'pool-lounge': 'poolLounge',
  'pool-terrace': 'poolTerrace',
  'pool-night': 'poolNight',
  'pergola-dining': 'pergolaDining',
  'living-dining': 'livingDining',
  'living-doors': 'livingDoors',
  'terrace-bbq': 'terraceBbq',
  'terrace-table': 'terraceTable',
  'garden-sofa': 'gardenSofa',
  'garden-palms': 'gardenPalms',
  'dusk-olive': 'duskOlive',
  living: 'living',
  dining: 'dining',
  snug: 'snug',
  kitchen1: 'kitchenOne',
  kitchen2: 'kitchenTwo',
  bedroom1: 'bedroomOne',
  bedroom2: 'bedroomTwo',
  bedroom3: 'bedroomThree',
  bedroom4: 'bedroomFour',
  bathroom1: 'bathroomOne',
  bathroom2: 'bathroomTwo',
  bathroom3: 'bathroomThree',
  facade: 'facade',
  courtyard: 'courtyard',
  gate: 'gate',
  view: 'view',
  gardens: 'gardens',
  aerial: 'aerial',
  dusk: 'dusk',
  villa: 'villa',
};

/*
 * The grid used to carry a caption on every tile, which on a phone (where the
 * captions are always visible) left text lying across every small photo. The
 * walk-through runs in blocks of related shots, so only the FIRST photo of
 * each block now shows a label, naming the whole block. The per-photo caption
 * is kept as the alt text and is what the lightbox shows once a visitor opens
 * a photo, so nothing is lost. Keys are the leading number of the filename;
 * renumber these too if the MAP in scripts/process-photos.mjs is re-ordered.
 */
const groupLeadByNumber: Record<string, string> = {
  '01': 'pool', // 01-09 pool and house
  '10': 'outdoor', // 10-13 terraces, garden lounge
  '14': 'indoor', // 14-17 living and dining
  '18': 'kitchens', // 18-19
  '20': 'bedrooms', // 20-23
  '24': 'bathrooms', // 24-26
  '27': 'arrival', // 27-29 facade, courtyard, gate
  '30': 'gardens', // 30-33 view, gardens, from above
  '34': 'evening', // 34-36 night and dusk
};

function captionKey(path: string): string {
  const base = path.split('/').pop() ?? '';
  for (const token of Object.keys(captionByToken)) {
    if (base.includes(token)) return captionByToken[token];
  }
  return 'villa';
}

const sorted = Object.entries(files).sort(([a], [b]) => a.localeCompare(b));

// Prepare optimized thumbnails + full-size sources (for PhotoSwipe).
const items = await Promise.all(
  sorted.map(async ([path, mod], i) => {
    const src = mod.default;
    const full = await getImage({ src, width: 1600, format: 'webp' });
    const caption = t(`gallery.captions.${captionKey(path)}`);
    const group = groupLeadByNumber[(path.split('/').pop() ?? '').slice(0, 2)];
    return {
      src,
      fullSrc: full.src,
      fullW: 1600,
      fullH: Math.round((1600 * src.height) / src.width),
      caption,
      // Block label, only on the first photo of each block.
      label: group ? t(`gallery.groups.${group}`) : null,
      // Emphasis pattern for a varied editorial grid.
      big: i === 0 || i === 3 || i === 6,
      index: i,
    };
  })
);
---

<section class="section gallery" id="gallery">
  <div class="container">
    <div class="gallery__head reveal">
      <div>
        <p class="eyebrow">{t('gallery.eyebrow')}</p>
        <h2 class="section-title">{t('gallery.title')}</h2>
        <p class="lead">{t('gallery.subtitle')}</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="gallery__grid reveal" id="gallery-grid">
      {items.map((item) => (
        <a
          class:list={['gallery__item', { 'gallery__item--big': item.big }]}
          href={item.fullSrc}
          data-pswp-width={item.fullW}
          data-pswp-height={item.fullH}
          target="_blank"
          rel="noopener"
          aria-label={item.caption}
        >
          <Image
            src={item.src}
            alt={item.caption}
            widths={[400, 700, 1000]}
            sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
            loading="lazy"
            class="gallery__img"
          />
          {item.label ? (
            <span class="gallery__caption">
              <span>{item.label}</span>
              <Icon name="expand" size={16} />
            </span>
          ) : (
            <span class="gallery__zoom" aria-hidden="true">
              <Icon name="expand" size={15} />
            </span>
          )}
        </a>
      ))}
    </div>

    <!-- The video sits AFTER the photos on purpose (owner, Nov 2026): the
         gallery should open with the house itself, not with a film. -->
    <div class="gallery__foot reveal">
      <button type="button" class="btn btn--ghost gallery__video-btn" data-video-open>
        <Icon name="play" size={18} />
        {t('gallery.video')}
      </button>
    </div>
  </div>

  <!--
    The player is NOT in the page until someone presses the button: the script
    builds the iframe on first open. That keeps YouTube from loading (and
    setting cookies) for every visitor, and keeps the page light.
  -->
  <div class="gallery__video" data-video-modal hidden>
    <div class="gallery__video-backdrop" data-video-close></div>
    <div class="gallery__video-box" role="dialog" aria-modal="true" aria-label={t('gallery.videoTitle')}>
      <button type="button" class="gallery__video-x" data-video-close aria-label={t('gallery.videoClose')}>
        <Icon name="close" size={22} />
      </button>
      <div class="gallery__video-frame" data-video-frame data-youtube-id={villa.video.youtubeId}></div>
    </div>
  </div>
</section>

<style>
  .gallery__head {
    max-width: var(--container-narrow);
    margin-bottom: 2.5rem;
  }
  .gallery__foot {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  /* Video overlay. Fixed, above everything, below nothing. */
  .gallery__video[hidden] {
    display: none;
  }
  .gallery__video {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .gallery__video-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 24, 20, 0.88);
    backdrop-filter: blur(3px);
  }
  .gallery__video-box {
    position: relative;
    width: min(100%, 1100px);
  }
  .gallery__video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    max-height: 80vh;
    margin-inline: auto;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow);
  }
  .gallery__video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .gallery__video-x {
    position: absolute;
    top: -3rem;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .gallery__video-x:hover {
    background: rgba(255, 255, 255, 0.28);
  }
  @media (max-width: 760px) {
    .gallery__video-x {
      top: -3.25rem;
    }
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    grid-auto-flow: dense;
  }
  .gallery__item {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }
  .gallery__item--big {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }
  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .gallery__item:hover .gallery__img {
    transform: scale(1.05);
  }
  .gallery__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 1.5rem 1.1rem 0.9rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #fff;
    background: linear-gradient(180deg, transparent, rgba(36, 31, 25, 0.6));
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .gallery__caption :global(svg) {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .gallery__item:hover .gallery__caption,
  .gallery__item:focus-visible .gallery__caption {
    opacity: 1;
    transform: none;
  }
  .gallery__item:hover .gallery__caption :global(svg) {
    opacity: 0.9;
    transform: none;
  }

  /* Tiles without a label still need to look openable, so they carry the
     zoom glyph on its own instead of a full caption bar. */
  .gallery__zoom {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    color: #fff;
    background: rgba(36, 31, 25, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .gallery__item:hover .gallery__zoom,
  .gallery__item:focus-visible .gallery__zoom {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 760px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }
    .gallery__item--big { grid-column: span 2; grid-row: span 1; aspect-ratio: 16 / 10; }
    .gallery__caption { opacity: 1; transform: none; padding-top: 2rem; }
    /* No hover on a phone: show the glyph, but keep it quiet. */
    .gallery__zoom { opacity: 0.75; transform: none; width: 1.6rem; height: 1.6rem; right: 0.5rem; bottom: 0.5rem; }
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery-grid',
    children: 'a.gallery__item',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.92,
    showHideAnimationType: 'zoom',
  });

  // Show the caption inside the lightbox.
  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'custom-caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      html: '',
      onInit: (el) => {
        el.className = 'pswp__custom-caption';
        lightbox.pswp?.on('change', () => {
          const curr = lightbox.pswp?.currSlide?.data.element as HTMLElement | undefined;
          const label = curr?.getAttribute('aria-label') ?? '';
          el.innerHTML = label;
        });
      },
    });
  });

  lightbox.init();

  /*
   * Video overlay. The iframe is created on the first open and then kept, so
   * YouTube is contacted only when a visitor asks for it. Closing resets the
   * src, otherwise the clip keeps playing behind the overlay.
   */
  const videoModal = document.querySelector<HTMLElement>('[data-video-modal]');
  const videoFrame = document.querySelector<HTMLElement>('[data-video-frame]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-video-open]');

  if (videoModal && videoFrame && openBtn) {
    const id = videoFrame.getAttribute('data-youtube-id');

    function openVideo() {
      if (!videoFrame.querySelector('iframe')) {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.title = openBtn.textContent?.trim() ?? 'Video';
        videoFrame.appendChild(iframe);
      } else {
        const iframe = videoFrame.querySelector('iframe') as HTMLIFrameElement;
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      }
      videoModal.hidden = false;
      document.body.style.overflow = 'hidden';
      videoModal.querySelector<HTMLButtonElement>('.gallery__video-x')?.focus();
    }

    function closeVideo() {
      videoModal.hidden = true;
      document.body.style.overflow = '';
      const iframe = videoFrame.querySelector('iframe');
      if (iframe) iframe.src = 'about:blank'; // stop playback
      openBtn.focus();
    }

    openBtn.addEventListener('click', openVideo);
    videoModal.querySelectorAll('[data-video-close]').forEach((el) =>
      el.addEventListener('click', closeVideo)
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !videoModal.hidden) closeVideo();
    });
  }
</script>

<style is:global>
  .pswp__custom-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    text-align: center;
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-display, Georgia, serif);
    font-style: italic;
    font-size: 1.05rem;
    pointer-events: none;
  }
</style>
