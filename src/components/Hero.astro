---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import heroImage from '../assets/images/hero.jpg';
import heroPhoneImage from '../assets/images/hero-phone.jpg';
import { useTranslations } from '../i18n';
import { villa, type Locale } from '../data/villa';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const statIcon: Record<string, string> = {
  guests: 'guests',
  bedrooms: 'bed',
  bathrooms: 'bath',
  pool: 'pool',
};

/*
 * Two heroes, picked by the browser so only one is ever downloaded.
 *
 * Wide screens get the dusk shot (02.jpg): the best image on the site, and its
 * pale sky keeps the dark logo in the header readable. Phones get a portrait
 * cut of the daylight pool shot (10.jpg), because a tall crop of the dusk
 * photo loses the villa altogether. See `mode: 'phone'` in
 * scripts/process-photos.mjs for how that cut is made.
 *
 * The 520px breakpoint matches the one on .hero__content below. It stops at
 * phones on purpose: the portrait image would be cropped hard on a tablet, and
 * a phone held sideways is wider than 520px, so it correctly gets the wide one.
 */
const heroWide = await getImage({
  src: heroImage,
  widths: [768, 1280, 1920, 2400],
  format: 'webp',
});
const heroPhone = await getImage({
  src: heroPhoneImage,
  widths: [600, 900, 1200],
  format: 'webp',
});
---

<section class="hero" id="top">
  <div class="hero__media">
    <picture>
      <source
        media="(max-width: 520px)"
        type="image/webp"
        srcset={heroPhone.srcSet.attribute}
        sizes="100vw"
      />
      <source type="image/webp" srcset={heroWide.srcSet.attribute} sizes="100vw" />
      <img
        src={heroWide.src}
        alt=""
        width={heroWide.attributes.width ?? 2400}
        height={heroWide.attributes.height ?? 1350}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero__img"
      />
    </picture>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__content container">
    <p class="hero__kicker">{t('hero.kicker')}</p>
    <h1 class="hero__title">{t('hero.title')}</h1>
    <p class="hero__subtitle">{t('hero.subtitle')}</p>

    <ul class="hero__stats">
      {villa.stats.map((s) => (
        <li class="chip">
          <Icon name={statIcon[s.id]} size={20} />
          <span>
            {s.value ? `${s.value} ` : ''}
            {t(`hero.stats.${s.id}`)}
          </span>
        </li>
      ))}
    </ul>

    <div class="hero__actions">
      <!-- Label is "Check availability", so it must land on the calendar
           (#booking), not the enquiry form. Request these dates in the
           calendar then carries the guest on to #enquire. -->
      <a href="#booking" class="btn hero__cta">{t('hero.cta')}</a>
      <a href="#gallery" class="btn btn--light">{t('hero.ctaSecondary')}</a>
    </div>
  </div>

  <a href="#intro" class="hero__scroll" aria-label={t('hero.ctaSecondary')}>
    <Icon name="chevron" size={26} />
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(3rem, 8vh, 6rem);
    padding-top: calc(var(--header-h) + 2rem);
    color: var(--c-white);
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom 18s var(--ease) forwards;
  }
  @keyframes heroZoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__img { animation: none; }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(36, 31, 25, 0.28) 0%,
      rgba(36, 31, 25, 0.05) 35%,
      rgba(36, 31, 25, 0.55) 100%
    );
  }

  .hero__content {
    max-width: 820px;
  }
  .hero__kicker {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }
  .hero__title {
    color: #fff;
    font-size: var(--fs-hero);
    font-weight: 400;
    margin: 0 0 1rem;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }
  .hero__subtitle {
    font-size: var(--fs-lead);
    max-width: 44ch;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.4);
    margin-bottom: 1.75rem;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    font-size: 0.92rem;
    font-weight: 500;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(6px);
    text-transform: capitalize;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero__cta {
    padding: 1rem 2rem;
    font-size: 1.05rem;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.8);
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll { animation: none; }
  }
  @media (max-width: 600px) {
    .hero__scroll { display: none; }
  }

  /*
   * Phone layout. The hero content is anchored to the bottom, so making the
   * chips and buttons smaller does not just shrink them: it lets the whole
   * block start lower, which is the point. On the phone hero the pool fills
   * everything below roughly a third of the screen, and white text over calm
   * water reads far better than over the stonework and the villa. The
   * breakpoint matches the <source media> above, so the compact block and the
   * portrait photo always arrive together.
   */
  @media (max-width: 520px) {
    /* One line on a 360px screen, which keeps the headline below the
       waterline instead of pushing it up onto the stonework. */
    .hero__kicker {
      font-size: 0.72rem;
      letter-spacing: 0.13em;
      margin-bottom: 0.7rem;
    }
    .hero__title {
      margin-bottom: 0.7rem;
    }
    .hero__subtitle {
      margin-bottom: 1.3rem;
    }
    .hero__stats {
      gap: 0.45rem;
      margin-bottom: 1.2rem;
    }
    .chip {
      gap: 0.35rem;
      padding: 0.35rem 0.7rem;
      font-size: 0.82rem;
    }
    .chip :global(svg) {
      width: 16px;
      height: 16px;
    }
    .hero__actions {
      gap: 0.6rem;
    }
    .hero__actions :global(.btn) {
      padding: 0.7rem 1.15rem;
      font-size: 0.92rem;
    }
    .hero__cta {
      padding: 0.7rem 1.25rem;
      font-size: 0.95rem;
    }
  }
</style>
