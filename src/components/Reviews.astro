---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';
import { villa, type Locale } from '../data/villa';
import { config } from '../config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * The section is always on the page, even with no reviews yet, because it
 * carries the "write a review" button that former guests are pointed at.
 * With an empty list it shows the invitation alone, under a plain heading
 * ("Reviews from our guests") instead of the claim that guests loved it.
 *
 * Nothing a visitor types here lands on the site by itself. The form sends an
 * e-mail, and a real review is added to `villa.reviews` by hand afterwards.
 * That is deliberate: it keeps spam and invented praise off the page, and the
 * owner can check the sender really stayed here.
 */
const reviews = villa.reviews;
const hasRating = villa.ratingAverage !== null && villa.ratingCount !== null;
const summary = hasRating
  ? t('reviews.ratingSummary')
      .replace('{avg}', String(villa.ratingAverage))
      .replace('{count}', String(villa.ratingCount))
  : '';

// Month names in the visitor's own language, generated at build time.
const monthFmt = new Intl.DateTimeFormat(locale, { month: 'long' });
const months = Array.from({ length: 12 }, (_, i) => {
  const label = monthFmt.format(new Date(Date.UTC(2000, i, 1)));
  return {
    value: String(i + 1).padStart(2, '0'),
    // nl/es give "januari" / "enero" in lower case; a dropdown reads better capitalised.
    label: label.charAt(0).toUpperCase() + label.slice(1),
  };
});
// This season and the five before it: far enough back for returning guests.
const thisYear = new Date().getFullYear();
const years = Array.from({ length: 6 }, (_, i) => thisYear - i);

const starLabel = (n: number) => t('reviews.form.starLabel').replace('{n}', String(n));

/*
 * A review's `date` is stored as "2025-07" and written out in the visitor's
 * own language here, so a Spanish reader does not get "July 2025". Never put
 * a month name in villa.ts.
 */
const stayFmt = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
const formatStay = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  const out = stayFmt.format(new Date(Date.UTC(y, (m || 1) - 1, 1)));
  return out.charAt(0).toUpperCase() + out.slice(1);
};
---

<section class="section reviews" id="reviews">
  <div class="container">
    <div class="reviews__head reveal">
      <p class="eyebrow">{t('reviews.eyebrow')}</p>
      <h2 class="section-title">
        {reviews.length > 0 ? t('reviews.title') : t('reviews.titleEmpty')}
      </h2>
      {hasRating && (
        <p class="reviews__rating">
          <span class="reviews__stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={22} />)}
          </span>
          <span class="reviews__summary">{summary}</span>
        </p>
      )}
    </div>

    {reviews.length > 0 && (
      <div class="reviews__grid" data-count={Math.min(reviews.length, 3)}>
        {reviews.map((review) => (
          <figure class="review reveal">
            <div class="review__stars" aria-label={`${review.rating} / 5`}>
              {Array.from({ length: review.rating }).map(() => <Icon name="star" size={16} />)}
            </div>
            <blockquote class="review__quote">{t(`reviews.items.${review.quoteId}`)}</blockquote>
            <figcaption class="review__by">
              <span class="review__name">{review.name}</span>
              <span class="review__meta">
                {[review.origin, formatStay(review.date)].filter(Boolean).join(' · ')}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="reviews__foot reveal">
      <p class="reviews__invite">{t('reviews.invite')}</p>
      <button type="button" class="btn reviews__write" data-review-open>
        <Icon name="star" size={18} />
        {t('reviews.write')}
      </button>
    </div>
  </div>

  <!--
    The form sits in an overlay so the page itself stays a sales page. It also
    opens straight away when someone arrives on #review, which is the link to
    mail to a guest: https://villacanmiro.com/nl/#review
  -->
  <div class="rv" data-review-modal hidden>
    <div class="rv__backdrop" data-review-close></div>
    <div class="rv__box" role="dialog" aria-modal="true" aria-labelledby="rv-title">
      <button type="button" class="rv__x" data-review-close aria-label={t('reviews.form.close')}>
        <Icon name="close" size={22} />
      </button>
      <h3 class="rv__title" id="rv-title">{t('reviews.form.title')}</h3>
      <p class="rv__intro">{t('reviews.form.intro')}</p>

      <form
        class="rv__form"
        data-review-form
        data-web3key={config.web3formsKey}
        data-email={config.email}
        data-msg-success={t('reviews.form.success')}
        data-msg-error={t('reviews.form.error')}
        data-msg-required={t('reviews.form.required')}
        data-msg-rating={t('reviews.form.ratingRequired')}
        data-sending={t('reviews.form.sending')}
        data-submit={t('reviews.form.submit')}
      >
        <div class="rv__field">
          <label for="rv-name">{t('reviews.form.name')} *</label>
          <input id="rv-name" name="name" type="text" required autocomplete="name" />
          <span class="rv__hint">{t('reviews.form.nameHint')}</span>
        </div>

        <div class="rv__field">
          <label for="rv-email">{t('reviews.form.email')} *</label>
          <input id="rv-email" name="email" type="email" required autocomplete="email" />
          <span class="rv__hint">{t('reviews.form.emailHint')}</span>
        </div>

        <div class="rv__field">
          <label for="rv-origin">{t('reviews.form.origin')}</label>
          <input id="rv-origin" name="origin" type="text" autocomplete="address-level2" />
          <span class="rv__hint">{t('reviews.form.originHint')}</span>
        </div>

        <div class="rv__field">
          <label for="rv-month">{t('reviews.form.stay')} *</label>
          <div class="rv__two">
            <!--
              Both start empty, so `required` actually fires. With a real month
              preselected a guest can send the wrong one without noticing.
            -->
            <select id="rv-month" name="stay_month" required>
              <option value="">{t('reviews.form.choose')}</option>
              {months.map((m) => <option value={m.value}>{m.label}</option>)}
            </select>
            <select id="rv-year" name="stay_year" required aria-label={t('reviews.form.stay')}>
              <option value="">{t('reviews.form.choose')}</option>
              {years.map((y) => <option value={y}>{y}</option>)}
            </select>
          </div>
        </div>

        <div class="rv__field">
          <span class="rv__label">{t('reviews.form.rating')} *</span>
          <!--
            Five radios in reverse order (5 first) so plain CSS can light up the
            chosen star and every star to its left with a sibling selector. The
            row is drawn back to front, so 1 still appears on the left. The
            inputs are visually hidden, so they carry no `required`: an
            invisible invalid control cannot be focused and the browser would
            swallow its own warning. The script checks it instead.
          -->
          <div class="rv__stars">
            {[5, 4, 3, 2, 1].map((n) => (
              <Fragment>
                <input
                  class="visually-hidden rv__star-input"
                  type="radio"
                  name="rating"
                  id={`rv-star-${n}`}
                  value={n}
                />
                <label class="rv__star" for={`rv-star-${n}`} title={starLabel(n)}>
                  <Icon name="star" size={30} />
                  <span class="visually-hidden">{starLabel(n)}</span>
                </label>
              </Fragment>
            ))}
          </div>
        </div>

        <div class="rv__field">
          <label for="rv-text">{t('reviews.form.text')} *</label>
          <textarea
            id="rv-text"
            name="review"
            rows="5"
            required
            placeholder={t('reviews.form.textPlaceholder')}></textarea>
        </div>

        <label class="rv__consent">
          <input type="checkbox" name="consent" value="yes" required />
          <span>{t('reviews.form.consent')} *</span>
        </label>

        <!-- Honeypot spam trap -->
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

        <button type="submit" class="btn rv__submit">{t('reviews.form.submit')}</button>
        <p class="rv__status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--bg-raised);
  }
  .reviews__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }
  .reviews__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
  }
  .reviews__stars { display: inline-flex; color: var(--c-terracotta); }
  .reviews__summary { color: var(--text-soft); font-weight: 500; }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  /* One or two reviews should not be stretched across a three-column row,
     nor left clinging to the left edge. */
  .reviews__grid[data-count='1'] {
    grid-template-columns: 1fr;
    max-width: 620px;
    margin-inline: auto;
  }
  .reviews__grid[data-count='2'] {
    grid-template-columns: repeat(2, 1fr);
    max-width: 900px;
    margin-inline: auto;
  }
  .review {
    background: var(--c-white);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin: 0;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .review__stars { display: inline-flex; color: var(--c-terracotta); }
  .review__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--heading);
    font-style: italic;
  }
  .review__by {
    margin-top: auto;
    display: grid;
    gap: 0.15rem;
  }
  .review__name { font-weight: 700; color: var(--heading); }
  .review__meta { font-size: var(--fs-small); color: var(--text-soft); }

  .reviews__foot {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    margin-top: 2.5rem;
  }
  .reviews__invite {
    margin: 0;
    max-width: 46ch;
    color: var(--text-soft);
  }
  .reviews__write { gap: 0.55rem; }

  /* Overlay with the form. Same pattern as the gallery video. */
  .rv[hidden] { display: none; }
  .rv {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 4vw, 2.5rem);
  }
  .rv__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 24, 20, 0.78);
    backdrop-filter: blur(3px);
  }
  .rv__box {
    position: relative;
    width: min(100%, 620px);
    max-height: 100%;
    overflow-y: auto;
    background: var(--c-white);
    color: var(--text);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.4rem, 4vw, 2.4rem);
  }
  .rv__x {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: inline-flex;
    padding: 0.45rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
  }
  .rv__x:hover { background: var(--bg-raised); color: var(--heading); }
  .rv__title {
    font-size: 1.6rem;
    color: var(--heading);
    margin: 0 2rem 0.5rem 0;
  }
  .rv__intro {
    margin: 0 0 1.5rem;
    color: var(--text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .rv__form { display: grid; gap: 1.1rem; }
  /* Grid children keep their min-content width unless told otherwise, and an
     input carries a browser default near 170px. See the note in Enquiry.astro. */
  .rv__form,
  .rv__field { min-width: 0; }
  .rv__field { display: flex; flex-direction: column; gap: 0.4rem; }
  .rv__field label,
  .rv__label {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--heading);
  }
  .rv__hint {
    font-size: 0.8rem;
    color: var(--text-soft);
    line-height: 1.4;
  }
  .rv__two {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 0.6rem;
    min-width: 0;
  }
  .rv__two > * { min-width: 0; }
  .rv__form input[type='text'],
  .rv__form input[type='email'],
  .rv__form select,
  .rv__form textarea {
    font: inherit;
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--c-sand-50);
    color: var(--text);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
    width: 100%;
  }
  .rv__form textarea { resize: vertical; }
  .rv__form input:focus,
  .rv__form select:focus,
  .rv__form textarea:focus {
    outline: none;
    border-color: var(--c-sea);
    box-shadow: 0 0 0 3px rgba(47, 109, 120, 0.15);
  }

  /* Stars: drawn right to left so `~` can reach the lower numbers. */
  .rv__stars {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.2rem;
    padding-top: 0.15rem;
  }
  .rv__star {
    display: inline-flex;
    color: var(--border);
    cursor: pointer;
    border-radius: 4px;
    transition: color 0.15s var(--ease), transform 0.15s var(--ease);
  }
  .rv__star-input:checked ~ .rv__star,
  .rv__stars:hover .rv__star:hover,
  .rv__stars:hover .rv__star:hover ~ .rv__star {
    color: var(--c-terracotta);
  }
  .rv__star:hover { transform: scale(1.08); }
  .rv__star-input:focus-visible + .rv__star {
    outline: 2px solid var(--c-sea);
    outline-offset: 2px;
  }

  .rv__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-soft);
    cursor: pointer;
  }
  .rv__consent input {
    margin-top: 0.15rem;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    accent-color: var(--c-terracotta);
  }

  .rv__submit { padding: 0.9rem; font-size: 1.02rem; }
  .rv__submit[disabled] { opacity: 0.7; cursor: progress; }
  .rv__status {
    margin: 0;
    font-size: 0.95rem;
    min-height: 1.2em;
    line-height: 1.5;
  }
  .rv__status[data-state='success'] { color: var(--c-olive); font-weight: 600; }
  .rv__status[data-state='error'] { color: var(--c-terracotta-dark); font-weight: 600; }

  @media (max-width: 860px) {
    .reviews__grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
  }
</style>

<script>
  const modal = document.querySelector('[data-review-modal]') as HTMLElement | null;
  const form = document.querySelector('[data-review-form]') as HTMLFormElement | null;

  if (modal && form) {
    const status = form.querySelector('[data-status]') as HTMLElement;
    const submit = form.querySelector('.rv__submit') as HTMLButtonElement;
    const key = form.dataset.web3key || '';
    const email = form.dataset.email || '';
    const labelSubmit = form.dataset.submit || 'Send';

    const setStatus = (msg: string, state: '' | 'success' | 'error') => {
      status.textContent = msg;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    const open = () => {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      (form.querySelector('#rv-name') as HTMLInputElement | null)?.focus();
    };
    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
      // Drop #review from the address bar, so a reload does not reopen it.
      if (location.hash === '#review') {
        history.replaceState(null, '', location.pathname + location.search);
      }
    };

    document.querySelectorAll('[data-review-open]').forEach((b) =>
      b.addEventListener('click', open)
    );
    modal.querySelectorAll('[data-review-close]').forEach((b) =>
      b.addEventListener('click', close)
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });

    // A link straight to the form, for mailing to a guest: .../#review
    const openFromHash = () => {
      if (location.hash === '#review') open();
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if ((data.get('botcheck') as string) === 'on') return; // spam trap

      if (!data.get('rating')) {
        setStatus(form.dataset.msgRating || '', 'error');
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus(form.dataset.msgRequired || '', 'error');
        return;
      }

      // One readable line ("Augustus 2026") instead of two numbered fields,
      // so the e-mail that arrives is easy to read.
      const monthSelect = form.querySelector('#rv-month') as HTMLSelectElement;
      const stay = `${monthSelect.selectedOptions[0]?.text ?? ''} ${data.get('stay_year')}`.trim();
      data.delete('stay_month');
      data.delete('stay_year');

      // No form-service key configured: hand it to the visitor's mail program.
      if (!key) {
        const lines = [
          `Name: ${data.get('name')}`,
          `Email: ${data.get('email')}`,
          `From: ${data.get('origin') || '-'}`,
          `Stay: ${stay}`,
          `Rating: ${data.get('rating')}/5`,
          '',
          `${data.get('review') || ''}`,
        ].join('\n');
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(
          'Can Miró review'
        )}&body=${encodeURIComponent(lines)}`;
        setStatus(form.dataset.msgSuccess || '', 'success');
        return;
      }

      submit.disabled = true;
      submit.textContent = form.dataset.sending || 'Sending…';
      setStatus('', '');

      try {
        data.append('access_key', key);
        data.append('subject', 'Can Miró review');
        data.append('from_name', 'Can Miró website');
        data.append('stay', stay);
        data.append('page_language', document.documentElement.lang || '');
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json();
        if (json.success) {
          setStatus(form.dataset.msgSuccess || '', 'success');
          form.reset();
        } else {
          setStatus(form.dataset.msgError || '', 'error');
        }
      } catch {
        setStatus(form.dataset.msgError || '', 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = labelSubmit;
      }
    });
  }
</script>
